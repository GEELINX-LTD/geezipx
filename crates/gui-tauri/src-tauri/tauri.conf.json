{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "GeeZipX",
  "version": "0.6.0",
  "identifier": "com.geelinx.geezipx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GeeZipX",
        "width": 900,
        "height": 640,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [".zip", ".zipx"],
        "name": "ZIP Archive",
        "description": "ZIP / ZIPX Archive",
        "mimeType": "application/zip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [".tar"],
        "name": "TAR Archive",
        "description": "TAR Archive",
        "mimeType": "application/x-tar",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [".gz"],
        "name": "GZip Compressed File",
        "description": "GZip Compressed File",
        "mimeType": "application/gzip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [".tar.gz", ".tgz"],
        "name": "GZip-Compressed TAR Archive",
        "description": "GZip-Compressed TAR Archive",
        "mimeType": "application/gzip",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.geelinx.geezipx.targz",
          "conformsTo": ["public.data", "public.archive"]
        }
      },
      {
        "ext": [".bz2"],
        "name": "BZip2 Compressed File",
        "description": "BZip2 Compressed File",
        "mimeType": "application/x-bzip2",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [".tar.bz2", ".tbz", ".tbz2"],
