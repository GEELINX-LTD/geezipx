        "mimeType": "application/x-bzip2",
        "role": "Viewer",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.geelinx.geezipx.tarbz2",
          "conformsTo": ["public.data", "public.archive"]
        }
      },
      {
        "ext": [".br"],
        "name": "Brotli Compressed File",
